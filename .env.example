# ============================================================
# NanaRoom · Supabase 云端同步配置模板
# ============================================================
# 1. 复制本文件，改名为 ".env.local"
# 2. 去 https://supabase.com 注册免费项目（新建 Project）
# 3. 打开项目 → Project Settings → API
#    把 Project URL 和 anon public 粘贴到下面：
# 4. 运行 npm run dev 即可生效（未配置则自动降级为本地 localStorage 模式）

# Supabase Project URL (匿名公网可读)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon public key (不是 service_role！service_role 只放服务器)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.......
